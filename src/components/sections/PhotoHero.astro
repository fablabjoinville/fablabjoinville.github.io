---
/**
 * <PhotoHero /> — home hero, "photo-first" (chosen from /lab/headers, variant 4).
 *
 * A full-bleed, flat (no overlay) lab photo sits right under the site header; a
 * white panel with a chamfered corner and a hard navy offset shadow overlaps it
 * bottom-left with the h1, lead and CTAs. A ruled "visit" strip (hours, place,
 * social links from site.ts) fills the space to the right on desktop. Below
 * 64em the photo stacks above the panel. Static, no client JS.
 *
 * Props
 *  - image: ImageMetadata (required)      imageAlt: string (required)
 *  - caption?: string   mono tag on the photo, e.g. "Festival Maker · 2023"
 *  - lead?: string
 *  - id?: string        h1 id (default "hero-titulo")
 * Slots
 *  - title (required)   h1 content; wrap the soft part in <span class="photohero-title__aside">
 *  - actions            CTA buttons
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { IconButton } from '@/components/ui';
import { site } from '@/data/site';

export interface Props {
  image: ImageMetadata;
  imageAlt: string;
  caption?: string;
  lead?: string;
  id?: string;
}

const { image, imageAlt, caption, lead, id = 'hero-titulo' } = Astro.props;
const hours = site.hours[0];
const place = site.address.building.split(',')[0];
---

<section class="photohero photohero-hero" aria-labelledby={id}>
  <figure class="photohero-media">
    <Image
      src={image}
      alt={imageAlt}
      widths={[480, 800, 1280, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="photohero-photo"
    />
    {caption && <figcaption class="photohero-caption">{caption}</figcaption>}
  </figure>

  <div class="flj-container photohero-stage">
    <div class="photohero-panel">
      <div class="photohero-panel__frame">
        <div class="photohero-panel__body">
          <h1 id={id} class="photohero-title"><slot name="title" /></h1>
          {lead && <p class="photohero-lead">{lead}</p>}
          {Astro.slots.has('actions') && (
            <div class="photohero-ctas">
              <slot name="actions" />
            </div>
          )}
        </div>
      </div>
    </div>

    <aside class="photohero-meta" aria-label="Visite o Fab Lab">
      <dl class="photohero-facts">
        <div class="photohero-fact">
          <dt class="photohero-fact__label">Horário</dt>
          <dd class="photohero-fact__value">
            <a href="#contato">
              {hours.days} · <span class="photohero-mono">{hours.time}</span>
            </a>
          </dd>
        </div>
        <div class="photohero-fact">
          <dt class="photohero-fact__label">Onde</dt>
          <dd class="photohero-fact__value">
            <a href="#contato">{place} · {site.address.city}/{site.address.state}</a>
          </dd>
        </div>
      </dl>
      <ul class="photohero-social" role="list" aria-label="Redes sociais">
        {
          site.social.map((s) => (
            <li>
              <IconButton
                icon={s.icon}
                label={s.label}
                variant="secondary"
                href={s.href}
                target="_blank"
                data-track={`hero-${s.name.toLowerCase()}`}
              />
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</section>

<style>
  .photohero {
    /* Local knobs (all derived from tokens). */
    --photohero-cut: calc(var(--chamfer) * 2);
    --photohero-cut-inner: calc(var(--photohero-cut) - var(--border-w) * 0.586);
    --photohero-shadow: var(--space-2);
    --photohero-overlap: var(--space-6);
    --photohero-pad: var(--space-5);

    background: var(--surface-page);
    color: var(--text-body);
  }

  /* ---------- Photo ---------- */
  .photohero-hero {
    position: relative;
    padding-bottom: var(--space-7);
    border-bottom: var(--border-w) solid var(--border-default);
  }

  .photohero-media {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface-muted);
    border-bottom: var(--border-w) solid var(--border-default);
  }

  .photohero-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 40%;
  }

  .photohero-caption {
    position: absolute;
    top: var(--space-4);
    right: var(--gutter);
    padding: var(--space-2) var(--space-3);
    background: var(--surface-card);
    border: var(--border-w) solid var(--border-default);
    border-radius: var(--radius-1);
    font: var(--type-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-body);
  }

  .photohero-caption::before {
    content: '// ';
    color: var(--text-accent);
  }

  /* ---------- Stage: panel + info strip ---------- */
  .photohero-stage {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-7);
    margin-top: calc(-1 * var(--photohero-overlap));
  }

  /* Panel = offset navy shadow (::before) + navy frame (2px "border" that also
     follows the chamfer) + white body. clip-path would cut a box-shadow, so the
     hard shadow is its own chamfered layer. */
  .photohero-panel {
    position: relative;
    isolation: isolate;
    max-width: 42rem;
    margin-right: var(--photohero-shadow);
  }

  .photohero-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--brand-primary);
    transform: translate(var(--photohero-shadow), var(--photohero-shadow));
    clip-path: polygon(0 0, calc(100% - var(--photohero-cut)) 0, 100% var(--photohero-cut), 100% 100%, 0 100%);
  }

  .photohero-panel__frame {
    padding: var(--border-w);
    background: var(--border-default);
    clip-path: polygon(0 0, calc(100% - var(--photohero-cut)) 0, 100% var(--photohero-cut), 100% 100%, 0 100%);
  }

  .photohero-panel__body {
    padding: var(--photohero-pad);
    background: var(--surface-card);
    clip-path: polygon(
      0 0,
      calc(100% - var(--photohero-cut-inner)) 0,
      100% var(--photohero-cut-inner),
      100% 100%,
      0 100%
    );
  }

  .photohero-title {
    margin: var(--space-4) 0 0;
    font-family: var(--font-display);
    font-weight: var(--fw-black);
    font-size: clamp(1.625rem, 7.2vw, var(--fs-56));
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-display);
    text-transform: uppercase;
    color: var(--text-strong);
  }

  /* "(quase)": same black weight, drawn as outline only (stacked-outline motif). */
  :global(.photohero-title__aside) {
    color: transparent;
    -webkit-text-stroke: 0.035em var(--text-strong);
  }

  @supports not (-webkit-text-stroke: 1px black) {
    :global(.photohero-title__aside) {
      color: var(--text-strong);
    }
  }

  .photohero-lead {
    max-width: 46ch;
    margin: var(--space-5) 0 0;
    font: var(--type-body-lg);
    color: var(--text-muted);
  }

  .photohero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .photohero-ctas :global(.flj-btn) {
    flex: 1 1 auto;
  }

  /* Info strip: ruled "bench" rows + social links. */
  .photohero-meta {
    display: grid;
    gap: var(--space-5);
  }

  .photohero-facts {
    display: grid;
    margin: 0;
  }

  .photohero-fact {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) 0;
    border-top: var(--border-w) solid var(--border-default);
  }

  .photohero-fact:last-child {
    border-bottom: var(--border-w) solid var(--border-default);
  }

  .photohero-fact__label {
    font: var(--type-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .photohero-fact__label::before {
    content: '// ';
  }

  .photohero-fact__value a {
    color: inherit;
    text-decoration: none;
  }

  .photohero-fact__value a:hover {
    color: var(--brand-accent-hover);
  }

  .photohero-fact__value {
    margin: 0;
    font: var(--type-body);
    font-weight: var(--fw-medium);
    color: var(--text-body);
  }

  .photohero-mono {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
  }

  .photohero-social {
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---------- ≥ 40em: wider photo, roomier panel ---------- */
  @media (min-width: 40em) {
    .photohero {
      --photohero-cut: calc(var(--chamfer) * 3);
      --photohero-shadow: calc(var(--space-2) + var(--border-w));
      --photohero-overlap: var(--space-8);
      --photohero-pad: var(--space-7);
    }

    .photohero-media {
      aspect-ratio: 16 / 9;
    }

    .photohero-caption {
      top: var(--space-5);
    }

    .photohero-ctas :global(.flj-btn) {
      flex: 0 0 auto;
    }
  }

  /* ---------- ≥ 64em: overlapping desktop composition ---------- */
  @media (min-width: 64em) {
    .photohero {
      --photohero-overlap: 18rem;
    }

    .photohero-media {
      aspect-ratio: auto;
      height: clamp(30rem, 66vh, 42rem);
    }

    .photohero-caption {
      top: var(--space-6);
      right: max(var(--gutter), calc((100% - var(--container)) / 2 + var(--gutter)));
    }

    .photohero-stage {
      grid-template-columns: minmax(0, 42rem) minmax(15rem, 1fr);
      grid-template-rows: var(--photohero-overlap) auto;
      column-gap: var(--space-7);
      row-gap: 0;
    }

    /* Panel stretches to the bottom of the info column (hours/place/social). */
    .photohero-panel {
      grid-column: 1;
      grid-row: 1 / span 2;
      display: flex;
      margin-right: 0;
    }

    .photohero-panel__frame {
      display: flex;
      flex: 1;
    }

    .photohero-panel__body {
      display: flex;
      flex: 1;
      flex-direction: column;
      justify-content: center;
    }

    /* Sits in the white band under the photo, right of the panel. */
    .photohero-meta {
      grid-column: 2;
      grid-row: 2;
      align-self: start;
      padding-top: var(--space-6);
    }
  }
</style>
