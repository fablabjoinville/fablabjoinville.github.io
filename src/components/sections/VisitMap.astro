---
/**
 * <VisitMap /> — home "Visite o Fab Lab" section ("Mapa com cartão", chosen from
 * /lab/contato, variant 1). Replaces ContactBlock on the home page.
 *
 * Concept: the map is the section. A tall, full-container-width vector map
 * carries the "where", and a single white info card (2px navy frame,
 * hard navy offset shadow, chamfered top-right corner, the extruded-symbol
 * motif) overlaps its left side and carries everything else: eyebrow, title,
 * the migrated invitation sentence, the one accent CTA and a compact ruled
 * list (Endereço · Horários · E-mail).
 *
 * How it removes the repetition: the old block showed the address twice
 * ("Localização" + the map caption) and split e-mail / localização / horários /
 * a navy "Agende a sua visita" card into four stacked blocks beside the map.
 * Here every fact appears exactly once, inside one card: the address is a
 * single line with the "Abrir no Google Maps" link next to it (the map has no
 * caption), the three hour rows sit in one list, and the visit card's title,
 * copy and CTA become the card's own header, so there is no second card.
 *
 * Layout: mobile-first. Below 64em the map sits on top (4:3, then 16:9) and the
 * card stacks directly under it. From 64em the map is 28rem tall and the card
 * overlaps its left side, hanging below the map if its content is taller. The
 * card is capped at half the map minus its inset, and the map is padded on the
 * left so the pin sits in the free area to the right of the card (about 78% of
 * the map width); the inset also keeps the zoom controls (top-right) and
 * attribution (bottom-right) uncovered.
 *
 * The map is MapLibre GL with OpenFreeMap's "Positron" vector style (free, no API
 * key) recoloured at runtime from the design-system tokens ("Natural" palette:
 * paper land, green-100 parks, blue-100 water), our brand-orange pin and two
 * place labels (Ágora Tech Park, UFSC) the tiles do not carry. It loads lazily
 * when the section nears the viewport; <noscript> keeps the plain OSM embed.
 */
import { Button, Icon } from '@/components/ui';
import { linkAttrs } from './utils';
import { site, fullAddress, mailto } from '@/data/site';

interface Props {
  /** Section id; defaults to "contato" (FAQ links to /#contato). */
  id?: string;
}

const { id = 'contato' } = Astro.props;
const titleId = `${id}-titulo`;

// Marker position (the Fab Lab, Ágora Tech Park); the script centres the map so the
// pin sits clear of the info card that overlaps the left side on desktop.
const MARKER = { lat: -26.2347, lng: -48.88307 };
---

<section id={id} class="visitmap" aria-labelledby={titleId}>
  <div class="flj-container">
    <div class="visitmap-stage">
      <div class="visitmap-map">
        <div
          class="visitmap-map__canvas"
          role="region"
          aria-label="Mapa de localização do Fab Lab Joinville"
          data-lat={MARKER.lat}
          data-lng={MARKER.lng}
          data-title="Fab Lab Joinville"
        >
        </div>
        <noscript>
          <iframe
            class="visitmap-map__frame"
            src={site.links.mapEmbed}
            title="Mapa de Localização Ágora Tech Park"
            loading="lazy"
            referrerpolicy="no-referrer"></iframe>
        </noscript>
      </div>

      <div class="visitmap-card">
        <div class="visitmap-card__frame">
          <div class="visitmap-card__body">
            <h2 id={titleId} class="visitmap-title">Agende a sua visita</h2>
            <p class="visitmap-lead">
              Quer conhecer as nossas tecnologias, desenvolver um projeto ou fazer uma visita guiada? Agende um
              horário com a nossa equipe.
            </p>
            <div class="visitmap-cta">
              <Button
                variant="accent"
                href={site.links.visitBooking}
                target="_blank"
                iconRight="arrow-up-right"
                data-track="visit-booking"
              >
                Escolher data e horário
              </Button>
            </div>

            <dl class="visitmap-facts">
              <div class="visitmap-fact">
                <dt class="visitmap-fact__label">
                  <Icon name="map-pin" size={16} />
                  Endereço
                </dt>
                <dd class="visitmap-fact__value">
                  <address class="visitmap-address">{fullAddress}</address>
                  <a
                    class="visitmap-maplink"
                    {...linkAttrs(site.links.mapLink)}
                    data-track="map-open"
                  >
                    Abrir no Google Maps
                    <Icon name="arrow-up-right" size={14} />
                  </a>
                </dd>
              </div>

              <div class="visitmap-fact">
                <dt class="visitmap-fact__label">
                  <Icon name="clock" size={16} />
                  Horários
                </dt>
                <dd class="visitmap-fact__value">
                  <ul class="visitmap-hours" role="list">
                    {
                      site.hours.map((h) => (
                        <li class="visitmap-hours__row">
                          <span class="visitmap-hours__days">{h.days}</span>
                          <span class="visitmap-hours__time">{h.time}</span>
                        </li>
                      ))
                    }
                  </ul>
                </dd>
              </div>

              <div class="visitmap-fact">
                <dt class="visitmap-fact__label">
                  <Icon name="mail" size={16} />
                  E-mail
                </dt>
                <dd class="visitmap-fact__value">
                  <a class="visitmap-email" href={mailto()}>{site.email}</a>
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Lazy-load MapLibre when the map is about to be seen.
  const canvas = document.querySelector<HTMLElement>('.visitmap-map__canvas');

  const STYLE_URL = 'https://tiles.openfreemap.org/styles/positron';
  /** Wider on mobile, where the map is narrow and the card stacks below it. */
  const ZOOM_MOBILE = 15.5;
  const ZOOM_DESKTOP = 16.5;
  /** Where the pin sits on desktop, as a fraction of the map (the card covers the left part). */
  const PIN_X = 0.785;
  const PIN_Y = 0.335;

  // Place names the vector tiles do not carry (coordinates from OpenStreetMap).
  const PLACES = [
    { name: 'Ágora Tech Park', lngLat: [-48.8824, -26.2359] as [number, number], strong: true },
    { name: 'UFSC', lngLat: [-48.88496, -26.23535] as [number, number], strong: false },
  ];

  // "Natural" palette: role -> design-system token (src/styles/tokens/colors.css).
  const PALETTE = {
    land: '--flj-paper',
    landuse: '--flj-gray-100',
    park: '--flj-green-100',
    water: '--flj-blue-100',
    building: '--flj-gray-200',
    buildingEdge: '--flj-gray-400',
    road: '--flj-white',
    roadCasing: '--flj-gray-200',
    roadMajorCasing: '--flj-gray-400',
    rail: '--flj-gray-400',
    boundary: '--flj-gray-400',
    text: '--flj-navy-800',
    halo: '--flj-paper',
  } as const;

  async function initMap(el: HTMLElement) {
    const [{ default: maplibregl }] = await Promise.all([
      import('maplibre-gl'),
      import('maplibre-gl/dist/maplibre-gl.css'),
    ]);
    const css = getComputedStyle(document.documentElement);
    const c = Object.fromEntries(
      Object.entries(PALETTE).map(([role, token]) => [role, css.getPropertyValue(token).trim()]),
    ) as Record<keyof typeof PALETTE, string>;

    // Recolour the Positron layers in place, by layer id / type.
    const style = await fetch(STYLE_URL).then((r) => r.json());
    for (const layer of style.layers) {
      const paint = (layer.paint ??= {});
      const id: string = layer.id;
      if (layer.type === 'background') paint['background-color'] = c.land;
      else if (layer.type === 'symbol') {
        paint['text-color'] = c.text;
        paint['text-halo-color'] = c.halo;
      } else if (layer.type === 'fill') {
        if (id === 'water') paint['fill-color'] = c.water;
        else if (id === 'building') {
          paint['fill-color'] = c.building;
          paint['fill-outline-color'] = c.buildingEdge;
        } else if (id === 'park' || id === 'landcover_wood') paint['fill-color'] = c.park;
        else if (id === 'landuse_residential') paint['fill-color'] = c.landuse;
        else paint['fill-color'] = c.land;
      } else if (layer.type === 'line') {
        if (id.startsWith('waterway')) paint['line-color'] = c.water;
        else if (id.startsWith('boundary')) paint['line-color'] = c.boundary;
        else if (id.startsWith('railway')) paint['line-color'] = c.rail;
        else if (id.includes('casing')) paint['line-color'] = /motorway|major/.test(id) ? c.roadMajorCasing : c.roadCasing;
        else paint['line-color'] = c.road;
      }
    }

    const marker: [number, number] = [Number(el.dataset.lng), Number(el.dataset.lat)];
    // On desktop the card covers the left of the map: pad the left (and bottom) so the pin sits at PIN_X / PIN_Y.
    const card = el.closest('.visitmap-stage')?.querySelector<HTMLElement>('.visitmap-card');
    const desktop = window.matchMedia('(min-width: 64em)').matches;
    const padding = { top: 0, right: 0, bottom: 0, left: 0 };
    if (card && desktop) {
      const overlap = card.getBoundingClientRect().right - el.getBoundingClientRect().left;
      padding.left = Math.max(overlap, (2 * PIN_X - 1) * el.clientWidth);
      padding.bottom = (1 - 2 * PIN_Y) * el.clientHeight;
    }

    const map = new maplibregl.Map({
      container: el,
      style,
      attributionControl: { compact: true },
    });
    map.jumpTo({ center: marker, zoom: desktop ? ZOOM_DESKTOP : ZOOM_MOBILE, padding });
    map.scrollZoom.disable();
    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');

    const pin = document.createElement('div');
    pin.className = 'visitmap-pin';
    pin.title = el.dataset.title ?? '';
    pin.innerHTML = `<svg viewBox="0 0 40 52" width="40" height="52" aria-hidden="true">
      <path class="visitmap-pin__body" d="M20 50C20 50 3 31 3 19a17 17 0 0 1 34 0c0 12-17 31-17 31Z" />
      <circle class="visitmap-pin__dot" cx="20" cy="19" r="6.5" />
    </svg>`;
    new maplibregl.Marker({ element: pin, anchor: 'bottom', offset: [0, 2] }).setLngLat(marker).addTo(map);

    const addLabel = (text: string, lngLat: [number, number], strong: boolean, anchor: 'center' | 'top' = 'center') => {
      const label = document.createElement('div');
      label.className = strong ? 'visitmap-place visitmap-place--strong' : 'visitmap-place';
      label.textContent = text;
      new maplibregl.Marker({ element: label, anchor, offset: anchor === 'top' ? [0, 6] : [0, 0] })
        .setLngLat(lngLat)
        .addTo(map);
    };
    // "Fab Lab" sits right under the pin tip.
    addLabel('Fab Lab', marker, true, 'top');
    for (const place of PLACES) addLabel(place.name, place.lngLat, place.strong);
  }

  if (canvas) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        void initMap(canvas);
      },
      { rootMargin: '200px' },
    );
    io.observe(canvas);
  }
</script>

<style>
  .visitmap {
    /* Local knobs (all derived from tokens). */
    --visitmap-cut: calc(var(--chamfer) * 2);
    --visitmap-cut-inner: calc(var(--visitmap-cut) - var(--border-w) * 0.586);
    --visitmap-shadow: var(--space-2);
    --visitmap-inset: var(--space-7);
    --visitmap-map-h: 28rem;

    padding-block: var(--space-8);
    background: var(--surface-page);
    color: var(--text-body);
    scroll-margin-top: var(--header-h);
  }

  /* ---------- Map ---------- */
  .visitmap-map {
    position: relative;
    /* Own stacking context: map panes and controls use their own z-index and must stay below the card. */
    z-index: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface-muted);
    border: var(--border-w) solid var(--border-default);
    border-radius: var(--radius-0);
  }

  .visitmap-map__canvas,
  .visitmap-map__frame {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* MapLibre chrome, restyled to the system (square corners, navy frame). */
  .visitmap-map__canvas :global(.maplibregl-map) {
    font: var(--type-small);
  }

  .visitmap-map__canvas :global(.maplibregl-ctrl-group) {
    border: var(--border-w) solid var(--border-default);
    border-radius: var(--radius-0);
    box-shadow: none;
  }

  .visitmap-map__canvas :global(.maplibregl-ctrl-attrib) {
    color: var(--text-body);
  }

  /* Place labels: mono label type with a paper halo so they read over roads. */
  .visitmap-map__canvas :global(.visitmap-place) {
    font: var(--type-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    color: var(--text-body);
    -webkit-text-stroke: 3px var(--surface-paper);
    paint-order: stroke fill;
  }

  .visitmap-map__canvas :global(.visitmap-place--strong) {
    font-weight: var(--fw-bold);
  }

  /* The pin: brand accent fill, navy outline, soft ground shadow. */
  .visitmap-map__canvas :global(.visitmap-pin) {
    filter: drop-shadow(0 3px 2px rgb(0 0 0 / 0.3));
  }

  .visitmap-map__canvas :global(.visitmap-pin svg) {
    display: block;
    overflow: visible;
  }

  .visitmap-map__canvas :global(.visitmap-pin__body) {
    fill: var(--brand-accent);
    stroke: var(--brand-primary);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }

  .visitmap-map__canvas :global(.visitmap-pin__dot) {
    fill: var(--surface-card);
  }

  /* ---------- Card ---------- */
  /* Card = offset navy shadow (::before) + navy frame (2px "border" that also
     follows the chamfer) + white body. clip-path would cut a box-shadow, so the
     hard shadow is its own chamfered layer. */
  .visitmap-card {
    position: relative;
    z-index: 1;
    isolation: isolate;
    margin-top: calc(-1 * var(--border-w));
    margin-right: var(--visitmap-shadow);
  }

  .visitmap-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--brand-primary);
    transform: translate(var(--visitmap-shadow), var(--visitmap-shadow));
    clip-path: polygon(0 0, calc(100% - var(--visitmap-cut)) 0, 100% var(--visitmap-cut), 100% 100%, 0 100%);
  }

  .visitmap-card__frame {
    padding: var(--border-w);
    background: var(--border-default);
    clip-path: polygon(0 0, calc(100% - var(--visitmap-cut)) 0, 100% var(--visitmap-cut), 100% 100%, 0 100%);
  }

  .visitmap-card__body {
    container-type: inline-size;
    padding: var(--space-5);
    background: var(--surface-card);
    clip-path: polygon(
      0 0,
      calc(100% - var(--visitmap-cut-inner)) 0,
      100% var(--visitmap-cut-inner),
      100% 100%,
      0 100%
    );
  }

  .visitmap-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--fw-black);
    font-size: clamp(var(--fs-24), 6vw, var(--fs-32));
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-display);
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .visitmap-lead {
    margin: var(--space-3) 0 0;
    font: var(--type-body);
    color: var(--text-body);
  }

  .visitmap-cta {
    margin-top: var(--space-5);
  }

  .visitmap-cta :global(.flj-btn) {
    width: 100%;
  }

  /* ---------- Ruled facts list ---------- */
  .visitmap-facts {
    margin: var(--space-5) 0 0;
    border-top: var(--border-w) solid var(--border-default);
  }

  .visitmap-fact {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-bottom: var(--border-w-thin) solid var(--border-subtle);
  }

  .visitmap-fact:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .visitmap-fact__label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font: var(--type-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .visitmap-fact__value {
    margin: 0;
    min-width: 0;
    font: var(--type-small);
    color: var(--text-body);
  }

  .visitmap-address {
    font-style: normal;
  }

  .visitmap-maplink {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-1);
    font: var(--type-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--brand-primary);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .visitmap-maplink:hover {
    color: var(--text-accent);
  }

  .visitmap-hours {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .visitmap-hours__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    column-gap: var(--space-3);
  }

  .visitmap-hours__row + .visitmap-hours__row {
    margin-top: var(--space-1);
  }

  .visitmap-hours__days {
    font-weight: var(--fw-semibold);
  }

  .visitmap-hours__time {
    font: var(--type-code);
    color: var(--text-body);
  }

  .visitmap-hours__row:last-child .visitmap-hours__time {
    color: var(--text-muted);
  }

  .visitmap-email {
    overflow-wrap: anywhere;
    color: var(--brand-primary);
    text-decoration: underline;
    text-decoration-thickness: var(--border-w-thin);
    text-underline-offset: 3px;
  }

  .visitmap-email:hover {
    color: var(--text-accent);
  }

  /* Wide card: label column + value column. */
  @container (min-width: 20rem) {
    .visitmap-fact {
      grid-template-columns: 6rem minmax(0, 1fr);
      column-gap: var(--space-4);
      align-items: baseline;
    }

    .visitmap-fact__label {
      align-self: start;
      padding-top: var(--space-1);
    }
  }

  @media (min-width: 40em) {
    .visitmap-map {
      aspect-ratio: 16 / 9;
    }

    .visitmap-cta :global(.flj-btn) {
      width: auto;
    }
  }

  /* ---------- Desktop: card overlaps the map ---------- */
  @media (min-width: 64em) {
    .visitmap {
      padding-block: var(--space-9);
    }

    .visitmap-stage {
      display: grid;
      /* Card column capped at half the map minus inset + breathing room, so the
         OSM marker (centred in the embed) is never hidden. */
      grid-template-columns:
        var(--visitmap-inset)
        min(28rem, calc(50% - var(--visitmap-inset) - var(--space-6)))
        minmax(0, 1fr);
      /* Rows 1–2 are the map (fixed height); row 3 absorbs any card overhang. */
      grid-template-rows: var(--visitmap-inset) calc(var(--visitmap-map-h) - var(--visitmap-inset)) auto;
    }

    .visitmap-map {
      grid-column: 1 / -1;
      grid-row: 1 / 3;
      aspect-ratio: auto;
    }

    .visitmap-card {
      grid-column: 2;
      grid-row: 2 / 4;
      align-self: start;
      margin: 0;
    }

    .visitmap-card__body {
      padding: var(--space-6);
    }

    .visitmap-cta :global(.flj-btn) {
      width: 100%;
    }
  }
</style>
