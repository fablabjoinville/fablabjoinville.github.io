---
/**
 * ContactVariant1 — "Mapa com cartão"
 *
 * Concept: the map is the section. A tall, full-container-width OpenStreetMap
 * embed carries the "where", and a single white info card (2px navy frame,
 * hard navy offset shadow, chamfered top-right corner, the extruded-symbol
 * motif) overlaps its left side and carries everything else: eyebrow, title,
 * the migrated invitation sentence, the one accent CTA and a compact ruled
 * list (Endereço · Horários · E-mail).
 *
 * How it removes the repetition: the old block showed the address twice
 * ("Localização" + the map caption) and split e-mail / localização / horários /
 * a navy "Agende a sua visita" card into four stacked blocks beside the map.
 * Here every fact appears exactly once, inside one card: the address is a
 * single line with the "Abrir no Google Maps" link next to it (the map has no
 * caption), the three hour rows sit in one list, and the visit card's title,
 * copy and CTA become the card's own header, so there is no second card.
 *
 * Layout: mobile-first. Below 64em the map sits on top (4:3, then 16:9) and the
 * card stacks directly under it. From 64em the map is 28rem tall and the card
 * overlaps its left side, hanging below the map if its content is taller. The
 * card is capped at half the map minus its inset, so the centred OSM marker
 * stays visible; its inset also keeps the OSM zoom controls (top-left) and
 * attribution (bottom-right) uncovered.
 *
 * Static: the iframe is rendered directly (loading="lazy"), no island.
 */
import { Button, Icon } from '@/components/ui';
import { site, fullAddress } from '@/data/site';

interface Props {
  /** Section id; defaults to "contato" (FAQ links to /#contato). */
  id?: string;
}

const { id = 'contato' } = Astro.props;
---

<section id={id} class="cv1" aria-labelledby="cv1-title">
  <div class="flj-container">
    <div class="cv1-stage">
      <div class="cv1-map">
        <iframe
          class="cv1-map__frame"
          src={site.links.mapEmbed}
          title="Mapa de Localização Ágora Tech Park"
          loading="lazy"
          referrerpolicy="no-referrer"></iframe>
      </div>

      <div class="cv1-card">
        <div class="cv1-card__frame">
          <div class="cv1-card__body">
            <p class="flj-eyebrow">Visite o Fab Lab</p>
            <h2 id="cv1-title" class="cv1-title">Agende a sua visita</h2>
            <p class="cv1-lead">
              Quer conhecer as nossas tecnologias, desenvolver um projeto ou fazer uma visita guiada? Agende um
              horário com a nossa equipe.
            </p>
            <div class="cv1-cta">
              <Button
                variant="accent"
                href={site.links.visitBooking}
                target="_blank"
                iconRight="arrow-up-right"
                data-track="visit-booking"
              >
                Escolher data e horário
              </Button>
            </div>

            <dl class="cv1-facts">
              <div class="cv1-fact">
                <dt class="cv1-fact__label">
                  <Icon name="map-pin" size={16} />
                  Endereço
                </dt>
                <dd class="cv1-fact__value">
                  <address class="cv1-address">{fullAddress}</address>
                  <a
                    class="cv1-maplink"
                    href={site.links.mapLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-track="map-open"
                  >
                    Abrir no Google Maps
                    <Icon name="arrow-up-right" size={14} />
                  </a>
                </dd>
              </div>

              <div class="cv1-fact">
                <dt class="cv1-fact__label">
                  <Icon name="clock" size={16} />
                  Horários
                </dt>
                <dd class="cv1-fact__value">
                  <ul class="cv1-hours" role="list">
                    {
                      site.hours.map((h) => (
                        <li class="cv1-hours__row">
                          <span class="cv1-hours__days">{h.days}</span>
                          <span class="cv1-hours__time">{h.time}</span>
                        </li>
                      ))
                    }
                  </ul>
                </dd>
              </div>

              <div class="cv1-fact">
                <dt class="cv1-fact__label">
                  <Icon name="mail" size={16} />
                  E-mail
                </dt>
                <dd class="cv1-fact__value">
                  <a class="cv1-email" href={`mailto:${site.email}`}>{site.email}</a>
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cv1 {
    /* Local knobs (all derived from tokens). */
    --cv1-cut: calc(var(--chamfer) * 2);
    --cv1-cut-inner: calc(var(--cv1-cut) - var(--border-w) * 0.586);
    --cv1-shadow: var(--space-2);
    --cv1-inset: var(--space-7);
    --cv1-map-h: 28rem;

    padding-block: var(--space-8);
    background: var(--surface-paper);
    color: var(--text-body);
    scroll-margin-top: var(--header-h);
  }

  /* ---------- Map ---------- */
  .cv1-map {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface-muted);
    border: var(--border-w) solid var(--border-default);
    border-radius: var(--radius-0);
  }

  .cv1-map__frame {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ---------- Card ---------- */
  /* Card = offset navy shadow (::before) + navy frame (2px "border" that also
     follows the chamfer) + white body. clip-path would cut a box-shadow, so the
     hard shadow is its own chamfered layer. */
  .cv1-card {
    position: relative;
    z-index: 1;
    isolation: isolate;
    margin-top: calc(-1 * var(--border-w));
    margin-right: var(--cv1-shadow);
  }

  .cv1-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--brand-primary);
    transform: translate(var(--cv1-shadow), var(--cv1-shadow));
    clip-path: polygon(0 0, calc(100% - var(--cv1-cut)) 0, 100% var(--cv1-cut), 100% 100%, 0 100%);
  }

  .cv1-card__frame {
    padding: var(--border-w);
    background: var(--border-default);
    clip-path: polygon(0 0, calc(100% - var(--cv1-cut)) 0, 100% var(--cv1-cut), 100% 100%, 0 100%);
  }

  .cv1-card__body {
    container-type: inline-size;
    padding: var(--space-5);
    background: var(--surface-card);
    clip-path: polygon(
      0 0,
      calc(100% - var(--cv1-cut-inner)) 0,
      100% var(--cv1-cut-inner),
      100% 100%,
      0 100%
    );
  }

  .cv1-title {
    margin: var(--space-3) 0 0;
    font-family: var(--font-display);
    font-weight: var(--fw-black);
    font-size: clamp(var(--fs-24), 6vw, var(--fs-32));
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-display);
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .cv1-lead {
    margin: var(--space-3) 0 0;
    font: var(--type-body);
    color: var(--text-body);
  }

  .cv1-cta {
    margin-top: var(--space-5);
  }

  .cv1-cta :global(.flj-btn) {
    width: 100%;
  }

  /* ---------- Ruled facts list ---------- */
  .cv1-facts {
    margin: var(--space-5) 0 0;
    border-top: var(--border-w) solid var(--border-default);
  }

  .cv1-fact {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-bottom: var(--border-w-thin) solid var(--border-subtle);
  }

  .cv1-fact:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .cv1-fact__label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font: var(--type-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .cv1-fact__value {
    margin: 0;
    min-width: 0;
    font: var(--type-small);
    color: var(--text-body);
  }

  .cv1-address {
    font-style: normal;
  }

  .cv1-maplink {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-1);
    font: var(--type-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--brand-primary);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .cv1-maplink:hover {
    color: var(--text-accent);
  }

  .cv1-hours {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cv1-hours__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    column-gap: var(--space-3);
  }

  .cv1-hours__row + .cv1-hours__row {
    margin-top: var(--space-1);
  }

  .cv1-hours__days {
    font-weight: var(--fw-semibold);
  }

  .cv1-hours__time {
    font: var(--type-code);
    color: var(--text-body);
  }

  .cv1-hours__row:last-child .cv1-hours__time {
    color: var(--text-muted);
  }

  .cv1-email {
    overflow-wrap: anywhere;
    color: var(--brand-primary);
    text-decoration: underline;
    text-decoration-thickness: var(--border-w-thin);
    text-underline-offset: 3px;
  }

  .cv1-email:hover {
    color: var(--text-accent);
  }

  /* Wide card: label column + value column. */
  @container (min-width: 20rem) {
    .cv1-fact {
      grid-template-columns: 6rem minmax(0, 1fr);
      column-gap: var(--space-4);
      align-items: baseline;
    }

    .cv1-fact__label {
      align-self: start;
      padding-top: var(--space-1);
    }
  }

  @media (min-width: 40em) {
    .cv1-map {
      aspect-ratio: 16 / 9;
    }

    .cv1-cta :global(.flj-btn) {
      width: auto;
    }
  }

  /* ---------- Desktop: card overlaps the map ---------- */
  @media (min-width: 64em) {
    .cv1 {
      padding-block: var(--space-9);
    }

    .cv1-stage {
      display: grid;
      /* Card column capped at half the map minus inset + breathing room, so the
         OSM marker (centred in the embed) is never hidden. */
      grid-template-columns:
        var(--cv1-inset)
        min(28rem, calc(50% - var(--cv1-inset) - var(--space-6)))
        minmax(0, 1fr);
      /* Rows 1–2 are the map (fixed height); row 3 absorbs any card overhang. */
      grid-template-rows: var(--cv1-inset) calc(var(--cv1-map-h) - var(--cv1-inset)) auto;
    }

    .cv1-map {
      grid-column: 1 / -1;
      grid-row: 1 / 3;
      aspect-ratio: auto;
    }

    .cv1-card {
      grid-column: 2;
      grid-row: 2 / 4;
      align-self: start;
      margin: 0;
    }

    .cv1-card__body {
      padding: var(--space-6);
    }

    .cv1-cta :global(.flj-btn) {
      width: 100%;
    }
  }
</style>
