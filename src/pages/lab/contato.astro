---
/**
 * TEMPORARY lab page (/lab/contato): the current home "Contato" section
 * (ContactBlock, as reference) followed by three alternative "visit us"
 * sections stacked for comparison. Each variant removes the repeated address
 * and shows every fact (address, hours, e-mail, booking CTA) exactly once,
 * keeping the OpenStreetMap embed.
 * noindex, excluded from Pagefind (data-pagefind-ignore) and from the sitemap
 * (astro.config.mjs filter). Section ids are made unique on this page; in
 * production the chosen section keeps id="contato" (FAQ links to /#contato).
 * Delete together with src/components/lab/ContactVariant*.astro once a
 * direction is chosen.
 */
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { ContactBlock } from '@/components/sections';
import ContactVariant1 from '@/components/lab/ContactVariant1.astro';
import ContactVariant2 from '@/components/lab/ContactVariant2.astro';
import ContactVariant3 from '@/components/lab/ContactVariant3.astro';

const variants = [
  {
    n: 1,
    name: 'Mapa com cartão',
    concept: 'Mapa largo com um único cartão branco chanfrado sobreposto',
    Component: ContactVariant1,
  },
  {
    n: 2,
    name: 'Faixa de dados',
    concept: 'Mapa em largura total soldado a uma faixa de três células (endereço · horários · e-mail)',
    Component: ContactVariant2,
  },
  {
    n: 3,
    name: 'Duas colunas enxutas',
    concept: 'Painel navy com CTA à esquerda, mapa com legenda única à direita',
    Component: ContactVariant3,
  },
];
---

<BaseLayout
  title="Lab · Contato"
  description="Página temporária com alternativas para a seção Contato da home do Fab Lab Joinville."
  noindex
>
  <div data-pagefind-ignore="all">
    <section class="lab-intro" aria-labelledby="lab-intro-title">
      <div class="flj-container">
        <p class="lab-intro__eyebrow">// LAB · TEMPORÁRIO</p>
        <h2 id="lab-intro-title" class="lab-intro__title">Alternativas para a seção Contato</h2>
        <p class="lab-intro__lead">
          A seção atual repete o endereço (em “Localização” e na legenda do mapa) e empilha e-mail, localização,
          horários e um cartão de visita ao lado do mapa. As três propostas abaixo mantêm o mapa e mostram cada
          informação uma única vez. Primeiro a versão atual, como referência.
        </p>
        <nav aria-label="Variantes" class="lab-jump">
          <ol>
            <li>
              <a href="#atual">
                <span class="lab-jump__n">00</span>
                Atual
              </a>
            </li>
            {
              variants.map((v) => (
                <li>
                  <a href={`#variante-${v.n}`}>
                    <span class="lab-jump__n">{String(v.n).padStart(2, '0')}</span>
                    {v.name}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </div>
    </section>

    <section id="atual" class="lab-variant" aria-label="Atual — seção Contato em produção">
      <div class="lab-label">
        <div class="flj-container lab-label__inner">
          <p class="lab-label__text">
            <strong>ATUAL — ContactBlock</strong>
            <span class="lab-label__concept"> · seção em produção na home (referência)</span>
          </p>
          <a class="lab-label__top" href="#conteudo">Topo ↑</a>
        </div>
      </div>
      <ContactBlock id="contato-atual" />
    </section>

    {
      variants.map(({ n, name, concept, Component }) => (
        <section id={`variante-${n}`} class="lab-variant" aria-label={`Variante ${n} — ${name}`}>
          <div class="lab-label">
            <div class="flj-container lab-label__inner">
              <p class="lab-label__text">
                <strong>
                  VARIANTE {n} — {name}
                </strong>
                <span class="lab-label__concept"> · {concept}</span>
              </p>
              <a class="lab-label__top" href="#conteudo">
                Topo ↑
              </a>
            </div>
          </div>
          <Component id={`contato-v${n}`} />
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .lab-intro {
    padding-block: var(--space-8);
    background: var(--surface-paper);
    border-bottom: var(--border-w) solid var(--border-default);
  }

  .lab-intro__eyebrow {
    margin: 0;
    font: var(--type-label);
    letter-spacing: var(--ls-label);
    color: var(--text-accent);
  }

  .lab-intro__title {
    margin: var(--space-3) 0 0;
    font: var(--type-h2);
    letter-spacing: var(--ls-display);
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .lab-intro__lead {
    max-width: 60ch;
    margin: var(--space-4) 0 0;
    font: var(--type-body-lg);
    color: var(--text-muted);
  }

  .lab-jump ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .lab-jump a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border: var(--border-w) solid var(--border-default);
    background: var(--surface-card);
    color: var(--text-body);
    font: var(--type-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: var(--shadow-offset-sm);
    transition: transform 120ms ease, box-shadow 120ms ease;
  }

  .lab-jump a:hover {
    transform: translate(-1px, -1px);
    box-shadow: var(--shadow-offset);
  }

  .lab-jump a:focus-visible {
    outline: var(--border-w) solid var(--focus-ring);
    outline-offset: var(--border-w);
  }

  .lab-jump__n {
    color: var(--text-accent);
  }

  .lab-variant {
    margin-top: var(--space-10);
    border-top: var(--border-w) solid var(--border-default);
    scroll-margin-top: var(--header-h);
  }

  .lab-variant:last-child {
    margin-bottom: var(--space-10);
    border-bottom: var(--border-w) solid var(--border-default);
  }

  .lab-label {
    background: var(--surface-inverse);
    color: var(--text-inverse);
    border-bottom: var(--border-w) solid var(--border-strong);
  }

  .lab-label__inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .lab-label__text {
    margin: 0;
    font: var(--type-label);
    letter-spacing: var(--ls-label);
    line-height: var(--lh-snug);
    text-transform: uppercase;
  }

  .lab-label__concept {
    font-weight: var(--fw-regular);
    color: var(--flj-navy-100);
  }

  .lab-label__top {
    flex-shrink: 0;
    font: var(--type-label);
    letter-spacing: var(--ls-label);
    color: var(--text-inverse);
    text-decoration: none;
  }

  .lab-label__top:hover {
    text-decoration: underline;
  }

  @media (max-width: 40em) {
    .lab-intro {
      padding-block: var(--space-7);
    }

    .lab-intro__title {
      font-size: var(--fs-32);
    }

    .lab-variant {
      margin-top: var(--space-8);
    }
  }
</style>
