---
/**
 * /cultura — "Fab Charter" (nav label). Migrated from the old Google Sites page:
 * title band + the 7 Fab Charter Q&A (pt-PT wording kept verbatim).
 * Copy lives in src/content/pages/cultura.md (header) and src/content/charter.yaml (Q&A).
 * Old heading anchors (#h.xxxx) keep working through QaList `legacyId`.
 */
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { PageHeader, QaList, Section } from '@/components/sections';
import { getSorted } from '@/lib/content-guard';
import { loadPage } from '@/lib/page';

const [{ data, headerImg }, charter] = await Promise.all([loadPage('cultura'), getSorted('charter')]);
const { title, description, eyebrow, lead, headerImage, headerImageAlt } = data;

const items = charter.map(({ id, data }) => ({
  id,
  question: data.question,
  answerHtml: data.answerHtml,
  legacyId: data.legacyId,
}));
---

<BaseLayout title={title} description={description} image={headerImage} imageAlt={headerImageAlt}>
  <PageHeader eyebrow={eyebrow} title={title} lead={lead} image={headerImg} imageAlt={headerImageAlt} />
  <Section id="fab-charter" narrow>
    <QaList items={items} headingLevel={2} openFirst />
  </Section>
</BaseLayout>
